# Apache — hospedagem compartilhada (cPanel, Hostinger, Locaweb e afins).
# Basta enviar o conteúdo de dist/ para public_html; este arquivo vai junto.
# Com back-end, envie também a pasta api/ ao lado do index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivo ou diretório existente é servido como está.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Com back-end, a pasta api/ tem roteador próprio e as rotas passam direto.
  # A condição importa: sem ela, uma publicação puramente estática devolveria
  # 404 na sondagem que a aplicação faz para descobrir se há servidor.
  RewriteCond %{DOCUMENT_ROOT}/api -d
  RewriteRule ^api/ - [L]

  # Qualquer outro caminho devolve o index: o roteador do navegador assume.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Assets com hash no nome podem ser eternos.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Sem listagem de diretório.
Options -Indexes

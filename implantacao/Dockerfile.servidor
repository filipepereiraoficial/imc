# Imagem com a aplicação e o servidor em PHP.
#
# O Dockerfile da raiz publica só a parte estática, com Nginx. Este aqui é o
# equivalente do modo com back-end: Apache com PHP, a aplicação construída e a
# pasta api/ ao lado dela — a mesma disposição de uma hospedagem compartilhada,
# que é onde a plataforma foi feita para viver.
#
#   docker compose -f implantacao/docker-compose-servidor.yml up -d
#
# O banco não vem embutido: o compose ao lado sobe um MariaDB separado.

# --- 1. Construção da aplicação -------------------------------------------
FROM node:22-alpine AS construcao
WORKDIR /obra

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run semente && npm run build

# --- 2. Servidor -----------------------------------------------------------
FROM php:8.3-apache

# pdo_mysql é a única extensão que a imagem não traz pronta.
RUN docker-php-ext-install pdo_mysql \
 && a2enmod rewrite headers \
 && rm -rf /var/lib/apt/lists/*

# A reescrita da aplicação vive nos .htaccess; sem isto o Apache os ignora.
RUN sed -ri 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf

COPY --from=construcao /obra/dist/ /var/www/html/
COPY api/ /var/www/html/api/

# config.php é gerado pelo instalador e nunca vem na imagem. Em contêiner ele
# mora num volume, apontado por OMCL_CONFIG — ver Config::caminho().
RUN rm -f /var/www/html/api/config.php \
 && mkdir -p /dados \
 && chown -R www-data:www-data /var/www/html /dados

# php.ini-production desliga a exibição de erros e endurece os padrões.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=15s \
  CMD php -r 'exit(@file_get_contents("http://127.0.0.1/api/estado") ? 0 : 1);'
